{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meisterwulf",
  "compatibility_date": "2026-09-01",

  // Serveerime ainult staatilisi faile — Workeri koodi pole vaja.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  // Domeenid seotakse `wrangler deploy` käigus automaatselt.
  // Eeldab, et meisterwulf.com on selles Cloudflare'i kontos tsoonina olemas.
  "routes": [
    { "pattern": "meisterwulf.com", "custom_domain": true },
    { "pattern": "www.meisterwulf.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
